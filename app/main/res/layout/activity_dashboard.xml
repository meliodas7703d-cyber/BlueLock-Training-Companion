<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blue_lock_main_bg"
    android:fitsSystemWindows="true">

    <!-- SUBTLE CHARACTER OVERLAY -->
    <ImageView
        android:layout_width="400dp"
        android:layout_height="600dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="-100dp"
        android:layout_marginBottom="-100dp"
        android:alpha="0.08"
        android:src="@drawable/hero_player"
        android:scaleType="fitEnd"
        android:contentDescription="" />

    <ScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <!-- HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="62dp">

                <ImageView
                    android:id="@+id/ivBrandLogo"
                    android:layout_width="178dp"
                    android:layout_height="56dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/bluelock"
                    android:scaleType="fitCenter"
                    android:contentDescription="Blue Lock Logo" />

                <FrameLayout
                    android:id="@+id/profileContainer"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/circle_profile_bg"
                    android:padding="2dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfilePhoto"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/profile_avatar"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                        android:contentDescription="Profile Photo" />

                    <TextView
                        android:id="@+id/tvProfileInitial"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvCompanion"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    android:text="" />

            </RelativeLayout>

            <!-- HERO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="228dp"
                android:layout_marginTop="7dp"
                android:background="#031124"
                android:clipChildren="true">

                <ImageView
                    android:id="@+id/ivHeroPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/hero_player"
                    android:scaleType="centerCrop"
                    android:contentDescription="Hero Player" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#45020812" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="125dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="#2196F3" />

                <LinearLayout
                    android:layout_width="188dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="7dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EGO IS THE FUEL."
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TRAIN LIKE A"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MONSTER."
                        android:textColor="#2196F3"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Welcome back,&#10;PLAYER"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Train. Improve. Compete. Become the best."
                        android:textColor="#C9D5E1"
                        android:textSize="9sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- XP + RANK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginTop="9dp"
                android:background="#06172B"
                android:orientation="horizontal"
                android:clipChildren="true">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#45020812" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="82dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="#2196F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="7dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/xp_icon"
                            android:scaleType="fitCenter"
                            android:contentDescription="XP" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="XP"
                                android:textColor="#9FB6D1"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvXp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPlayerLevel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LV. 1"
                                android:textColor="#C9D5E1"
                                android:textSize="9sp" />

                            <ProgressBar
                                android:id="@+id/progressRank"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="118dp"
                                android:layout_height="5dp"
                                android:layout_marginTop="5dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="#2196F3" />

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="95dp"
                    android:layout_gravity="center_vertical"
                    android:background="#18334E" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#45020812" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="82dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="#2196F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="7dp">

                        <ImageView
                            android:layout_width="49dp"
                            android:layout_height="56dp"
                            android:src="@drawable/rank_badge"
                            android:scaleType="fitCenter"
                            android:contentDescription="Rank" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RANK"
                                android:textColor="#9FB6D1"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRankName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="ROOKIE STRIKER"
                                android:textColor="#2196F3"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvNextRank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="500 XP to LV. 2"
                                android:textColor="#9FB6D1"
                                android:textSize="8sp" />

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

            <!-- TODAY'S PROGRESS -->
            <LinearLayout
                android:id="@+id/dailyTrainingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#06172B"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S MISSION PROGRESS"
                    android:textColor="#64B5F6"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp">

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressTint="#102B48" />

                        <ProgressBar
                            android:id="@+id/progressTraining"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#2196F3" />

                        <TextView
                            android:id="@+id/tvProgressPercent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="0%"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTrainingProgressDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Training Sessions: 0 / 1"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvRepsProgressDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Reps Completed: 0 / 20"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSkillsProgressDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Different Skills: 0 / 2"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end"
                    android:text="TAP FOR DETAILS ›"
                    android:textColor="#2196F3"
                    android:textSize="8sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TRAINING + CHALLENGES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <!-- TRAINING -->

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#0B3D8F"
                    android:clipChildren="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/training_player"
                        android:scaleType="centerCrop"
                        android:contentDescription="Training Player" />

                    <!-- SAME HERO DARK OVERLAY -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#45020812" />

                    <!-- SAME HERO BLUE LINE -->

                    <View
                        android:layout_width="3dp"
                        android:layout_height="82dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="#2196F3" />

                    <Button
                        android:id="@+id/btnTraining"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical|start"
                        android:paddingStart="14dp"
                        android:text="TRAINING&#10;&#10;START TRAINING  ›"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- CHALLENGES -->

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#321669"
                    android:clipChildren="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/trophy"
                        android:scaleType="centerInside"
                        android:contentDescription="Challenges" />

                    <!-- SAME HERO DARK OVERLAY -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#45020812" />

                    <!-- ACCENT -->

                    <View
                        android:layout_width="3dp"
                        android:layout_height="82dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="#7C4DFF" />

                    <Button
                        android:id="@+id/btnChallenge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical|start"
                        android:paddingStart="14dp"
                        android:text="CHALLENGES&#10;&#10;JOIN &amp; COMPETE  ›"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </LinearLayout>

            <!-- QUICK ACCESS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="QUICK ACCESS"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- PERFORMANCE -->
                <LinearLayout
                    android:id="@+id/layoutPerformance"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#082D5B"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/performance_quickaccess"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="PERFORMANCE"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <!-- Hidden buttons for listener compatibility if needed,
                         or I can update the listeners in Activity -->
                    <Button
                        android:id="@+id/btnPerformance"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- PROGRESS -->
                <LinearLayout
                    android:id="@+id/layoutProgress"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="#08264D"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/progress_icon"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="PROGRESS"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnProgress"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- BADGES -->
                <LinearLayout
                    android:id="@+id/layoutAchievements"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#25154B"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/badges_icon"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="BADGES"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAchievements"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

            <!-- SKILL OVERVIEW -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="SKILL OVERVIEW"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="106dp"
                        android:layout_height="148dp"
                        android:layout_marginEnd="6dp"
                        android:background="#06182C"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:src="@drawable/shooting_icon"
                            android:scaleType="fitCenter"
                            android:contentDescription="Shooting" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Shooting"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvShooting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:lineSpacingExtra="1dp"
                            android:text="Level 1&#10;Beginner&#10;0 / 20"
                            android:textColor="#64B5F6"
                            android:textSize="8sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="106dp"
                        android:layout_height="148dp"
                        android:layout_marginEnd="6dp"
                        android:background="#06182C"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:src="@drawable/passing_icon"
                            android:scaleType="fitCenter"
                            android:contentDescription="Passing" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Passing"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPassing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:lineSpacingExtra="1dp"
                            android:text="Level 1&#10;Beginner&#10;0 / 20"
                            android:textColor="#64B5F6"
                            android:textSize="8sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="106dp"
                        android:layout_height="148dp"
                        android:layout_marginEnd="6dp"
                        android:background="#06182C"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:src="@drawable/dribbling_icon"
                            android:scaleType="fitCenter"
                            android:contentDescription="Dribbling" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Dribbling"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDribbling"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:lineSpacingExtra="1dp"
                            android:text="Level 1&#10;Beginner&#10;0 / 20"
                            android:textColor="#64B5F6"
                            android:textSize="8sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="106dp"
                        android:layout_height="148dp"
                        android:layout_marginEnd="6dp"
                        android:background="#06182C"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:src="@drawable/ball_control_icon"
                            android:scaleType="fitCenter"
                            android:contentDescription="Ball Control" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Ball Control"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBallControl"
                            android:layout_width="match_parent"
