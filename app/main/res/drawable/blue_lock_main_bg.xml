<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#020814" />
        </shape>
    </item>

    <!-- Top Left Glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0%"
                android:centerY="0%"
                android:gradientRadius="400dp"
                android:startColor="#1A2196F3"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>

    <!-- Bottom Right Glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="100%"
                android:centerY="100%"
                android:gradientRadius="400dp"
                android:startColor="#1A0D47A1"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>