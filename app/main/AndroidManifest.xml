<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET IS REQUIRED FOR FIREBASE -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- OPENING VIDEO / LAUNCHER -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- LOGIN -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- REGISTER -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- LOGIN INTRO VIDEO -->
        <activity
            android:name=".IntroVideoActivity"
            android:exported="false" />

        <!-- FIRST TIME PROFILE SETUP -->
        <activity
            android:name=".ProfileSetupActivity"
            android:exported="false" />

        <!-- DASHBOARD -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- EDIT PROFILE -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".TrainingSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".TrainingActivity"
            android:exported="false" />

        <activity
            android:name=".ChallengesActivity"
            android:exported="false" />
        <activity
            android:name=".PerformanceActivity"
            android:exported="false" />

        <activity
            android:name=".ProgressActivity"
            android:exported="false" />

        <activity
            android:name=".BadgesActivity"
            android:exported="false" />

        <activity
            android:name=".HelpFeedbackActivity"
            android:exported="false" />

        <!-- ADMIN PANEL -->
        <activity
            android:name=".AdminPanelActivity"
            android:exported="false" />

    </application>

</manifest>